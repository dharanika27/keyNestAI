# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/
.expo/
*.egg-info/

# Env and secrets — never commit real values
.env
.env.local
.env.*.local
*.pem
*.key

# Local vault/test data — never commit vault content
*.vault
*.sqlite
*.sqlite3
!tests/fixtures/**/*.sqlite

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
