# Placeholders only. Never commit real credentials.
# Copy to .env and fill in local/dev values.

# services/api
DATABASE_URL=postgresql+psycopg://keynest:changeme@localhost:5432/keynest_dev
JWT_SIGNING_KEY=changeme-dev-only-generate-a-real-secret
ENVIRONMENT=development

# Google OAuth (web + mobile clients; see docs/backup-recovery-design.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# services/ai (optional; core vault features must work without this set)
AI_SERVICE_ENABLED=false
AI_MODEL_PROVIDER=
AI_MODEL_API_KEY=
